{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sitio",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "port": 8765
    },
    {
      "name": "sitio-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec python3 -m http.server \"${PORT:-8766}\" --bind 127.0.0.1"],
      "port": 8766
    }
  ]
}
